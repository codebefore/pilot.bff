{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Performance": {
    "ServiceName": "pilot-bff",
    "SlowRequestMs": 1000,
    "SlowDependencyMs": 250
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstanceName": "pilot",
    "EnvironmentName": "dev",
    "KeyPepper": ""
  },
  "Identity": {
    "BaseUrl": "http://pilot-identity",
    "TimeoutSeconds": 10
  },
  "Bff": {
    "BrowserSecurity": {
      "AllowedOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000"
      ]
    },
    "DataProtection": {
      "CertificateBase64": "",
      "CertificatePassword": ""
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": "",
      "KnownNetworks": ""
    },
    "Session": {
      "Enabled": false,
      "CookieName": "__Host-pilot_session",
      "IdleTimeoutMinutes": 30,
      "AbsoluteTimeoutHours": 12,
      "AccessTokenRefreshSkewSeconds": 60,
      "ActivityRenewalMinutes": 5,
      "RefreshLockLeaseSeconds": 15,
      "RefreshLockWaitMilliseconds": 2000
    },
    "Proxy": {
      "Enabled": false,
      "GatewayBaseUrl": "http://pilot-gateway",
      "TimeoutSeconds": 30,
      "ResponseStreamingTimeoutSeconds": 300,
      "MaxRequestBodyBytes": 10485760,
      "DocumentUploadMaxRequestBodyBytes": 11534336,
      "InstructorDocumentUploadMaxRequestBodyBytes": 27262976,
      "ReadRequestsPerMinute": 120,
      "MutationRequestsPerMinute": 30,
      "ReadConcurrentRequests": 50,
      "MutationConcurrentRequests": 10
    }
  }
}
